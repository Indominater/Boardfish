{
  "name": "boardfish",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "web": "node scripts/serve-web.mjs --preview",
    "web:preview": "node scripts/serve-web.mjs --preview",
    "web:dev": "node scripts/serve-web.mjs --dev",
    "build": "tauri build",
    "pretest": "node scripts/sync-debug-tools.mjs",
    "test": "node --test",
    "check:js-syntax": "node scripts/check-js-syntax.mjs",
    "check:static": "node --test test/static_refactor.test.js",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check": "npm run check:js-syntax && npm test && npm run check:static && npm run check:rust"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
