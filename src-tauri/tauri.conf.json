{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Boardfish",
  "version": "1.1.1",
  "identifier": "com.boardfish.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev:build",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "",
        "width": 1280,
        "height": 800,
        "visible": false,
        "theme": "Light",
        "backgroundColor": "#e0e0e3",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/boardfish-image-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
